{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "shop-harness": {
      "source": {
        "source": "github",
        "repo": "koldovsky/2026-spd-shop-harness",
        "ref": "v1.5.0"
      }
    }
  },
  "enabledPlugins": {
    "team-core@shop-harness": true
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(../*/.env)",
      "Bash(git push --force *)",
      "PowerShell(git push --force *)"
    ],
    "ask": [
      "Bash(git push *)",
      "PowerShell(git push *)"
    ]
  }
}
